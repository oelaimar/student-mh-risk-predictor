# ===== Version control =====
.git/
.gitignore

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== Tests & quality =====
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ===== Environment variables (never bake secrets into images) =====
.env
.env.*
!.env.example

# ===== Data (mounted at runtime instead) =====
data/raw/
data/processed/
data/**/*.csv
data/**/*.parquet
data/**/*.pkl

# ===== Generated artifacts (mounted at runtime instead) =====
models/
reports/
logs/
notebooks/
airflow.db
airflow-webserver.pid
standalone_admin_password.txt

# ===== Docker =====
docker-compose.override.yml
.dockerignore

# ===== Docs =====
README.md
docs/

# ===== OS / IDE =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
