# =============================================================================
# student-mh-risk-predictor — environment configuration
#
# Copy this file to `.env` and adjust the values for your environment:
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
# Secret key used by the webserver to sign session cookies.
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=change-me

# UID of the host user running the Airflow containers (Linux only).
# Set this to your own UID (`id -u`) to avoid permission issues on the
# bind-mounted ./dags, ./logs, ./src, ./data, ./models and ./reports folders.
AIRFLOW_UID=50000

# Initial admin account created once by the airflow-init service.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# PostgreSQL (Airflow metadata database)
# -----------------------------------------------------------------------------
# These are the defaults used by docker-compose.yml. Change them there as well
# if you want different credentials; the postgres service does not read .env.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# -----------------------------------------------------------------------------
# Jupyter (dev profile)
# -----------------------------------------------------------------------------
# Access token for JupyterLab:
#   docker compose --profile dev up jupyter
JUPYTER_TOKEN=jury

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# PROJECT_ROOT is set inside each service/image, so it normally does not need
# to be overridden here:
#   Airflow   -> /opt/project
#   Streamlit -> /app
#   Jupyter   -> /project
# PROJECT_ROOT=/opt/project
